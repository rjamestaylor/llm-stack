#!/bin/bash
# gollm — single entry point for the LLM stack
#
# Install once:  ln -sf ~/projects/llm-stack/gollm /usr/local/bin/gollm
#
# Usage:
#   gollm status               Full context snapshot (default if no args)
#   gollm start [webui|all]    Start Ollama; optionally start Open WebUI too
#   gollm stop  [webui|all]    Stop Ollama; webui = WebUI only; all = both
#   gollm restart              Restart Ollama (and WebUI if running)
#   gollm pull <model>         Pull a model from Ollama registry
#   gollm import <file.gguf> [name]  Import a local GGUF file into Ollama
#   gollm models               List local Ollama models (alias: gollm ls)
#   gollm ps                   Show models currently loaded in memory
#   gollm rm <model>           Remove a model from Ollama
#   gollm webui start|stop     Manage Open WebUI independently
#   gollm mlx start|stop|restart|status [model]  Manage MLX server
#   llm help                 This help

set -euo pipefail

# ── Paths ─────────────────────────────────────────────────────────────────────
REPO_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
SCRIPTS="$REPO_DIR/scripts"
MODELS_CONF="$REPO_DIR/models.conf"

# ── Colors ────────────────────────────────────────────────────────────────────
G='\033[0;32m'; B='\033[0;34m'; Y='\033[1;33m'; R='\033[0;31m'
BOLD='\033[1m'; D='\033[2m'; NC='\033[0m'

die()  { echo -e "${R}Error:${NC} $*" >&2; exit 1; }
info() { echo -e "${B}→${NC} $*"; }
ok()   { echo -e "${G}✓${NC} $*"; }
warn() { echo -e "${Y}⚠${NC} $*"; }

# ── Helpers ───────────────────────────────────────────────────────────────────
ollama_running() {
    curl -s --max-time 2 http://localhost:11434/api/tags > /dev/null 2>&1
}

webui_running() {
    docker ps --format "{{.Names}}" 2>/dev/null | grep -q "^open-webui$"
}

default_model() {
    # First model tagged "default" in models.conf, stripped of whitespace
    grep -v '^\s*#' "$MODELS_CONF" 2>/dev/null \
      | grep '|.*default' \
      | head -1 \
      | awk -F'|' '{print $1}' \
      | xargs
}

# ── Commands ──────────────────────────────────────────────────────────────────
cmd_status() {
    bash "$SCRIPTS/status.sh" "$@"
}

cmd_start() {
    local target="${1:-ollama}"
    case "$target" in
        ollama)
            if ollama_running; then
                warn "Ollama already running at http://localhost:11434"
            else
                info "Starting Ollama…"
                bash "$SCRIPTS/start-ollama.sh"
            fi
            ;;
        webui)
            info "Starting Open WebUI…"
            bash "$SCRIPTS/start-webui.sh"
            ;;
        all|stack)
            cmd_start ollama
            cmd_start webui
            ;;
        *)
            # Treat as model name: start ollama then load model
            if ! ollama_running; then
                cmd_start ollama
            fi
            info "Loading model: $target"
            ollama run "$target" --nowordwrap
            ;;
    esac
}

cmd_stop() {
    local target="${1:-ollama}"
    case "$target" in
        ollama)
            if ! pgrep -x "ollama" > /dev/null; then
                warn "Ollama is not running"
            else
                info "Stopping Ollama…"
                bash "$SCRIPTS/stop-ollama.sh"
            fi
            ;;
        webui)
            if ! webui_running; then
                warn "Open WebUI is not running"
            else
                info "Stopping Open WebUI…"
                bash "$SCRIPTS/stop-webui.sh"
            fi
            ;;
        all|stack)
            cmd_stop webui
            cmd_stop ollama
            ;;
        *)
            die "Unknown target '$target'. Use: ollama | webui | all"
            ;;
    esac
}

cmd_restart() {
    local webui_was_running=false
    webui_running && webui_was_running=true

    cmd_stop ollama
    sleep 1
    cmd_start ollama

    if $webui_was_running; then
        cmd_stop webui
        cmd_start webui
    fi
}

cmd_pull() {
    [[ -z "${1:-}" ]] && die "Usage: gollm pull <model>"
    info "Pulling $1…"
    ollama pull "$1"
    ok "Pulled $1"
}

cmd_import() {
    local gguf="${1:-}"
    local name="${2:-}"

    [[ -z "$gguf" ]] && die "Usage: gollm import <file.gguf> [model-name]"
    [[ ! -f "$gguf" ]] && die "File not found: $gguf"

    # Derive a name if not provided
    if [[ -z "$name" ]]; then
        basename="${gguf##*/}"         # strip path
        basename="${basename%.gguf}"   # strip extension
        # lowercase and replace dots/underscores with hyphens for Ollama convention
        name=$(echo "$basename" | tr '[:upper:]' '[:lower:]' | tr '_.' '-')
        info "Derived model name: $name  (pass a second arg to override)"
    fi

    local modelfile
    modelfile=$(mktemp /tmp/llm-import-XXXXXX.Modelfile)
    echo "FROM $gguf" > "$modelfile"

    info "Importing $gguf as $name…"
    ollama create "$name" -f "$modelfile"
    rm -f "$modelfile"

    ok "Imported as $name — run: ollama run $name"
    echo ""
    warn "Once confirmed working, you can delete the source file:"
    echo "  rm \"$gguf\""
}

cmd_models() {
    if ! ollama_running; then
        warn "Ollama is not running — showing registry from models.conf only"
        echo ""
        echo -e "${BOLD}Configured models (models.conf):${NC}"
        grep -v '^\s*#' "$MODELS_CONF" 2>/dev/null | grep -v '^\s*$' | while IFS='|' read -r name desc tags; do
            printf "  %-30s %s\n" "$(echo "$name" | xargs)" "$(echo "$desc" | xargs)"
        done
        return
    fi

    echo -e "${BOLD}Local Ollama models:${NC}"
    ollama list
    echo ""

    # Show what's in memory
    PS=$(ollama ps 2>/dev/null | tail -n +2)
    if [[ -n "$PS" ]]; then
        echo -e "${BOLD}Loaded in memory:${NC}"
        echo "$PS"
    fi
}

cmd_ps() {
    ollama_running || die "Ollama is not running"
    ollama ps
}

cmd_rm() {
    [[ -z "${1:-}" ]] && die "Usage: gollm rm <model>"
    info "Removing $1…"
    ollama rm "$1"
    ok "Removed $1"
}

cmd_webui() {
    local action="${1:-status}"
    case "$action" in
        start)  cmd_start webui ;;
        stop)   cmd_stop webui ;;
        status)
            if webui_running; then
                ok "Open WebUI is running → http://localhost:3000"
            else
                warn "Open WebUI is not running"
            fi
            ;;
        *)  die "Usage: gollm webui start|stop|status" ;;
    esac
}

mlx_running() {
    local pid_file="$HOME/.mlx/mlx.pid"
    [[ -f "$pid_file" ]] && ps -p "$(cat "$pid_file")" > /dev/null 2>&1
}

cmd_mlx() {
    local action="${1:-status}"
    shift 2>/dev/null || true
    case "$action" in
        start)   bash "$SCRIPTS/start-mlx.sh" "$@" ;;
        stop)    bash "$SCRIPTS/stop-mlx.sh" ;;
        restart)
            bash "$SCRIPTS/stop-mlx.sh"
            sleep 1
            bash "$SCRIPTS/start-mlx.sh" "$@"
            ;;
        status)
            if mlx_running; then
                local pid model port
                pid=$(cat "$HOME/.mlx/mlx.pid")
                model=$(cat "$HOME/.mlx/mlx.model" 2>/dev/null || echo "unknown")
                port=$(grep "MLX_PORT" "$REPO_DIR/mlx.conf" 2>/dev/null | grep -v '#' | cut -d'"' -f2 || echo "8080")
                ok "MLX server running (PID $pid) → http://localhost:${port}/v1"
                echo -e "  Model: ${B}$model${NC}"
            else
                warn "MLX server is not running"
                echo -e "  Start with: ${B}gollm mlx start${NC}"
            fi
            ;;
        log)
            # Filter known cosmetic warnings that don't affect model behaviour
            tail -f "$HOME/.mlx/mlx.log" | grep -v "fix_mistral_regex\|incorrect regex pattern\|This will lead to incorrect tokenization"
            ;;
        *)  die "Usage: gollm mlx start|stop|restart|status|log [model]" ;;
    esac
}

cmd_help() {
    echo ""
    echo -e "${BOLD}gollm — LLM Stack management${NC}"
    echo -e "${D}$REPO_DIR${NC}"
    echo ""
    echo -e "${BOLD}Usage:${NC}  gollm <command> [args]"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    printf "  ${G}%-28s${NC} %s\n" "status"              "Full context snapshot (default)"
    printf "  ${G}%-28s${NC} %s\n" "start [webui|all]"   "Start Ollama, optionally WebUI"
    printf "  ${G}%-28s${NC} %s\n" "stop  [webui|all]"   "Stop services (default: Ollama)"
    printf "  ${G}%-28s${NC} %s\n" "restart"             "Restart Ollama (+ WebUI if running)"
    printf "  ${G}%-28s${NC} %s\n" "pull <model>"        "Pull a model from Ollama registry"
    printf "  ${G}%-28s${NC} %s\n" "import <f.gguf> [n]" "Import a local GGUF into Ollama"
    printf "  ${G}%-28s${NC} %s\n" "models  (alias: ls)" "List local models"
    printf "  ${G}%-28s${NC} %s\n" "ps"                  "Show models loaded in VRAM"
    printf "  ${G}%-28s${NC} %s\n" "rm <model>"          "Remove a model from Ollama"
    printf "  ${G}%-28s${NC} %s\n" "webui start|stop"    "Manage Open WebUI independently"
    printf "  ${G}%-28s${NC} %s\n" "mlx start|stop|status" "Manage MLX server (OpenAI API on :8080)"
    printf "  ${G}%-28s${NC} %s\n" "mlx log"             "Tail MLX server log"
    printf "  ${G}%-28s${NC} %s\n" "help"                "This message"
    echo ""
    echo -e "${BOLD}Config:${NC}  $MODELS_CONF"
    DEFMODEL=$(default_model)
    [[ -n "$DEFMODEL" ]] && echo -e "${BOLD}Default model:${NC} $DEFMODEL"
    echo ""
    echo -e "${D}To install globally: ln -sf $REPO_DIR/gollm /usr/local/bin/gollm${NC}"
    echo ""
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
CMD="${1:-status}"
shift 2>/dev/null || true

case "$CMD" in
    status)             cmd_status "$@" ;;
    start)              cmd_start  "$@" ;;
    stop)               cmd_stop   "$@" ;;
    restart)            cmd_restart    ;;
    pull)               cmd_pull   "$@" ;;
    import)             cmd_import "$@" ;;
    models|ls|list)     cmd_models     ;;
    ps)                 cmd_ps         ;;
    rm|remove)          cmd_rm     "$@" ;;
    webui)              cmd_webui  "$@" ;;
    mlx)                cmd_mlx    "$@" ;;
    help|--help|-h)     cmd_help       ;;
    *)                  die "Unknown command '$CMD'. Run: gollm help" ;;
esac
